# Environment Configuration for ScoreX (v3.0.0)
# Copy these to your local .env or Railway project's environment variables

# SERVER CONFIGURATION
PORT=5001
NODE_ENV=production

# DATABASE (Optional - leave empty for deterministic file storage)
DATABASE_URL=

# STORAGE (Point to Railway volume if using persistent storage)
DATA_DIR=/app/data

# CANONICAL 5-TIER GOOGLE / GEMINI / DEEPMIND MODEL STACK
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_ORCHESTRATOR_MODEL=google-omni-1.1
GEMINI_PRO_MODEL=gemini-3.1-pro-preview
GEMINI_FLASH_MODEL=gemini-3.8-flash
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview
GEMINI_VIDEO_MODEL=veo-3.1-generate-preview
GEMINI_AUDIO_MODEL=lyria-3.5
GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image-preview
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# CORS
ALLOWED_ORIGINS=*

# FEATURE FLAGS
ENABLE_SAMPLE_GENERATOR=true

# EMAIL CONFIGURATION (Optional - for sending assignment notifications)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-16-char-app-password
EMAIL_FROM=ScoreX Platform <noreply@scorex.ai>
FRONTEND_URL=http://localhost:5001
