# Environment Configuration for ScoreX (v3.0.0)
# Copy these to your local .env or Railway project's environment variables

# SERVER CONFIGURATION
PORT=5001
NODE_ENV=production

# DATABASE (Optional - leave empty for deterministic file storage)
DATABASE_URL=

# STORAGE (Point to Railway volume if using persistent storage)
DATA_DIR=/app/data

# CANONICAL GOOGLE / GEMINI / VERTEX AI MODEL STACK
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_ORCHESTRATOR_MODEL=gemini-2.5-pro
GEMINI_PRO_MODEL=gemini-2.5-pro
GEMINI_FLASH_MODEL=gemini-2.5-flash
GEMINI_LIVE_MODEL=gemini-2.5-flash
GEMINI_VIDEO_MODEL=veo-3.1-generate-001
GEMINI_AUDIO_MODEL=lyria-002
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
GEMINI_IMAGE_MODEL=imagen-3.0-generate-002
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# CORS
ALLOWED_ORIGINS=*

# FEATURE FLAGS
ENABLE_SAMPLE_GENERATOR=true

# EMAIL CONFIGURATION (Optional - for sending assignment notifications)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-16-char-app-password
EMAIL_FROM=ScoreX Platform <noreply@scorex.ai>
FRONTEND_URL=http://localhost:5001
