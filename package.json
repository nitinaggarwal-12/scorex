{
  "name": "scorex",
  "version": "1.0.0",
  "description": "ScoreX - A comprehensive Enterprise Data & AI maturity assessment platform",
  "main": "server/index.js",
  "scripts": {
    "dev": "bash scripts/dev-local.sh",
    "dev:legacy": "concurrently \"npm run server\" \"npm run client\"",
    "server": "nodemon server/index.js",
    "client": "cd client && npm start",
    "build": "cd client && npm install --include=dev && CI=false npm run build",
    "install-all": "npm install && cd client && npm install --include=dev",
    "start": "NODE_ENV=production node server/index.js",
    "heroku-postbuild": "cd client && npm install --include=dev && CI=false npm run build",
    "vercel-build": "cd client && npm install --include=dev && CI=false npm run build",
    "migrate": "node server/db/migrate.js",
    "db:migrate": "node server/db/migrate.js",
    "test": "node --test tests/security/*.test.js",
    "update:workflows": "node scripts/update-workflow-assets.js",
    "update:workflows:remote": "TEST_URL=https://scorex.up.railway.app node scripts/update-workflow-assets.js"
  },
  "dependencies": {
    "@google/genai": "^2.17.1",
    "axios": "^1.19.0",
    "bcryptjs": "^2.4.3",
    "body-parser": "^1.20.6",
    "cheerio": "^1.1.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "exceljs": "^4.4.0",
    "express": "^4.22.2",
    "express-fileupload": "^1.5.2",
    "express-session": "^1.18.2",
    "form-data": "^4.0.6",
    "nodemailer": "^9.0.5",
    "openai": "^6.3.0",
    "pg": "^8.16.3",
    "uuid": "^11.1.1"
  },
  "overrides": {
    "express": {
      "path-to-regexp": "0.1.13"
    },
    "exceljs": {
      "tmp": "0.2.7",
      "uuid": "11.1.1"
    },
    "cheerio": {
      "undici": "7.29.0"
    },
    "glob": {
      "minimatch": {
        ".": "3.1.4",
        "brace-expansion": "1.1.18"
      }
    },
    "readdir-glob": {
      "minimatch": {
        ".": "5.1.8",
        "brace-expansion": "2.1.4"
      }
    }
  },
  "devDependencies": {
    "chalk": "^5.6.2",
    "concurrently": "^8.2.0",
    "nodemon": "^3.0.1"
  },
  "keywords": [
    "databricks",
    "maturity",
    "assessment",
    "analytics",
    "data"
  ],
  "author": "Databricks Maturity Assessment Team",
  "license": "MIT",
  "engines": {
    "node": "20.x",
    "npm": ">=9.0.0"
  }
}
